@page "/login"
@layout AuthLayout
@inject IAuthApi AuthApi
@inject AppState AppState
@inject NavigationManager NavigationManager
@inject AuthState AuthState

<SectionContent SectionName="pageTitle">Login</SectionContent>

<div class="">
    <EditForm Model="_model" OnValidSubmit="LoginAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">UserName</label>
            <InputText @bind-Value="_model.Username" class="form-control app-entry" placeholder="Enter username" />
            <ValidationMessage For="() => _model.Username" class="text-danger" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password" @bind-Value="_model.Password" class="form-control app-entry" placeholder="Enter password" />
            <ValidationMessage For="() => _model.Password" class="text-danger" />
        </div>
        <div class="mb-3 d-grid">
            <button type="submit" class="btn btn-app">Login</button>
        </div>
        <div class="my-3 hstack gap-2">
            <hr style="width: calc(50% - 42px);" />
            <span style="width: 84px;" class="text-center">New User?</span>
            <hr style="width: calc(50% - 42px);" />
        </div>
        <div class="d-grid">
            <NavLink href="/register" class="btn btn-outline-app">Register</NavLink>
        </div>
    </EditForm>
</div>

@code {
    private LoginDto _model = new();

    private async Task LoginAsync()
    {
        AppState.ShowLoader();
        try
        {
            var response = await AuthApi.LoginAsync(_model);
            if (!response.IsSuccess)
            {
                await MauiInterop.AlertAsync(response.ErrorMessage, "Error");
                return;
            }

            // Save UserInfo in LocalStorage
            AuthState.Login(response.Data);
            NavigationManager.NavigateTo(AuthState.RedirectUrlFromLogin, replace: true);
            AuthState.RedirectUrlFromLogin = "/";
        }
        finally
        {
            AppState.HideLoader();
        }
    }
}
