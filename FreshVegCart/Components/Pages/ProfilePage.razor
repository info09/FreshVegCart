@page "/profile"
@inject AuthState AuthState
@inject NavigationManager NavigationManager

<SectionContent SectionName="pageTitle">
    Profile
</SectionContent>

@if (AuthState.IsLoggedIn)
{
    <div class="container my-3">
        <div class="row">
            <div class="col-12 d-flex flex-column gap-2 justify-content-center align-items-center">
                <div class="bg-app-primary text-white square rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bx bx-sm bx-user"></i>
                </div>
                <label class="h3 mt-3">@AuthState.User.Name</label>
            </div>
        </div>
        <div class="row bg-white mt-3">
            <div class="col-12">
                <ul class="list-unstyled">
                    <li class="p-2 border-bottom d-flex gap-2">
                        <i class="bx bx-sm bx-lock text-app-primary"></i>
                        <div class="menu-name flex-grow-1">
                            <label class="text-app-primary">Change Password</label>
                            <small class="text-secondary mt-1 d-block">Update your Password</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bx bx-chevron-right text-secondary"></i>
                        </div>
                    </li>
                    <li class="p-2 border-bottom d-flex gap-3">
                        <i class="bx bx-sm bx-edit text-app-primary"></i>
                        <div class="menu-name flex-grow-1">
                            <label class="text-app-primary">Edit Profile</label>
                            <small class="text-secondary mt-1 d-block">Update your Name or Mobile number</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bx bx-chevron-right text-secondary"></i>
                        </div>
                    </li>
                    <li class="p-2 border-bottom d-flex gap-3">
                        <i class="bx bx-sm bx-map text-app-primary"></i>
                        <div class="menu-name flex-grow-1">
                            <label class="text-app-primary">Manage address</label>
                            <small class="text-secondary mt-1 d-block">Manage address</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bx bx-chevron-right text-secondary"></i>
                        </div>
                    </li>
                    <li class="p-2 border-bottom d-flex gap-3" @onclick="LogoutAsync">
                        <i class="bx bx-sm bx-log-out text-app-primary"></i>
                        <div class="menu-name flex-grow-1">
                            <label class="text-app-primary">Logout</label>
                            <small class="text-secondary mt-1 d-block">Logout system</small>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bx bx-chevron-right text-secondary"></i>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}



@code {
    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            await MauiInterop.AlertAsync("Login required", "Please login to view profile");
            AuthState.RedirectUrlFromLogin = "/profile";
            NavigationManager.NavigateTo("/login", replace: true);
        }
    }

    private async Task LogoutAsync()
    {
        if (await MauiInterop.ConfirmAsync("Logout", "Are you sure you want to logout?"))
        {
            AuthState.Logout();
            NavigationManager.NavigateTo("/", replace: true);
        }
    }
}
